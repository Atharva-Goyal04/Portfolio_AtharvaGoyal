# Public site URL — used for absolute metadata/OG URLs, canonical links, and sitemap.
# Production: your real domain (e.g. https://www.yourdomain.com) once it's assigned.
# Development: defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign the gallery unlock cookie.
# MUST be a long random value in production — e.g. `openssl rand -hex 32`.
GALLERY_SECRET=change-me-in-production

# --- Phase 5 (R2 photo CDN) — filled in when Cloudflare R2 is provisioned ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=   # optional: public bucket domain (R2.dev or custom)